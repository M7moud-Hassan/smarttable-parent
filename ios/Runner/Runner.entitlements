<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- بلا هذا الحق يفشل تسجيل الجهاز في APNs وقت التشغيل برسالة
	     "no valid aps-environment entitlement string found". وموضعه هنا لا في
	     Info.plist — النظام يقرأه من ملف الـ entitlements وحده. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
